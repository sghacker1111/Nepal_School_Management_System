Options -Indexes
<FilesMatch "(?i)\.(sqlite3?(-[a-z]+)?|db(-[a-z]+)?|sql|log|env|bak|bat|md|py|ps1|sh|ini|toml|ya?ml)$">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule (^|/)(\.[^/]+|config|includes|scratch|tests|docs|backups)(/|$) - [F,L]
RewriteRule ^uploads/.*\.(php[0-9]*|phtml|phar)$ - [F,L,NC]
