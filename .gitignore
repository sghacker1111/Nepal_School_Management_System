# Ignore local SQLite database
database.sqlite
*.sqlite-wal
*.sqlite-shm
/.backups/
.env
.env.*

# Ignore uploads directory content (uploaded signatures/logos)
/uploads/*
!/uploads/.gitkeep

# Ignore scratch files and logs
/scratch/
*.log
__pycache__/
*.py[cod]
.vscode/
.idea/

# Build tools are local/CI-only. Generated public bundles are committed.
node_modules/
frontend/generated-utilities.css
# Rebuilt by npm run build in local/CI; these public assets DO deploy over FTP.
/assets/vendor/

# Private MySQL configuration and migration packages are not source code.
config/*.local.php
*.sqlite
*.sqlite3
*.db
school_erp_mysql*.sql*
*.sql.gz
*.sql.statements.jsonl
migration-manifest*.json
source-manifest*.json
projected-manifest*.json
migration-report*.md
*migration-report*.json
verification-error.json
statements.jsonl
/exports/
/private-migration/
