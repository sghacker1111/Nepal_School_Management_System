# Ignore local SQLite database
database.sqlite
*.sqlite-wal
*.sqlite-shm
/.backups/
.env
.env.*

# Ignore uploads directory content (uploaded signatures/logos)
/uploads/*
!/uploads/.gitkeep

# Ignore scratch files and logs
/scratch/
*.log
__pycache__/
*.py[cod]
.vscode/
.idea/

# Build tools are local/CI-only. Generated public bundles are committed.
node_modules/
frontend/generated-utilities.css

# Private MySQL configuration and migration packages are not source code.
config/*.local.php
*.sqlite
*.sqlite3
*.db
school_erp_mysql*.sql*
migration-manifest*.json
migration-report*.md
/exports/
/private-migration/
